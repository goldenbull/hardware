menu "LCD Clock 配置"

    config APP_WIFI_SSID
        string "Wi-Fi SSID"
        default "your ssid"
        help
            要连接的无线网络名称。ESP32-C5 支持 2.4GHz 和 5GHz。

    config APP_WIFI_PASSWORD
        string "Wi-Fi 密码"
        default "your password"

    config APP_NTP_SERVER
        string "NTP 服务器"
        default "ntp.aliyun.com"
        help
            主服务器。连不上时会依次换 ntp.tencent.com、ntp.ntsc.ac.cn、
            cn.pool.ntp.org（备用列表在 net_time.c 里）。

    config APP_TIMEZONE
        string "时区（POSIX TZ 字符串）"
        default "CST-8"
        help
            北京时间为 CST-8。注意 POSIX 的符号是反的，东八区写 -8。

    config APP_TEMP_HOT_THRESHOLD
        int "火焰动画触发温度（摄氏度）"
        default 30

    config APP_TEMP_COLD_THRESHOLD
        int "雪花动画触发温度（摄氏度）"
        default 20

    config APP_SHT4X_PWR_GPIO
        int "SHT45 供电 GPIO（-1 = 接 3V3 电源轨）"
        range -1 28
        default -1
        help
            SHT45 的 VDD 接到某个 GPIO 上时填这个 GPIO，开机时最先拉高。
            接板上 3V3 就保持 -1。

    config APP_BRIGHTNESS_DEFAULT
        int "开机背光亮度 (%)"
        range 5 100
        default 60

    config APP_IMU_AUTO_FLIP
        bool "根据 IMU 自动把屏幕翻转 180°"
        default y

    choice APP_IMU_UP_AXIS
        prompt "IMU 上哪个轴对着屏幕的上下方向"
        depends on APP_IMU_AUTO_FLIP
        default APP_IMU_UP_AXIS_Y
        help
            这块板子上是 Y 轴（amoled-clock 那块是 X 轴）。开机日志会打印三个轴的读数：把板子横着立起来，
            读数接近 ±1g 的那个轴就是。

        config APP_IMU_UP_AXIS_X
            bool "X"
        config APP_IMU_UP_AXIS_Y
            bool "Y"
    endchoice

    config APP_IMU_UP_INVERT
        bool "IMU 方向取反（屏幕立正了却显示倒的就勾上）"
        depends on APP_IMU_AUTO_FLIP
        default n

    config APP_VOICE_ENABLE
        bool "声控开关屏"
        default y
        help
            麦克风持续采集，按下面选的方式开关屏。

    choice APP_VOICE_MODE
        prompt "声控方式"
        depends on APP_VOICE_ENABLE
        default APP_VOICE_MODE_LEVEL

        config APP_VOICE_MODE_LEVEL
            bool "音量触发：听到够响的声音就切换开 / 关"
            help
                卧室很安静时最省事：拍一下手、清一下嗓子就切换。
                不区分说的是什么，所以只能"切换"，不能单独开或关。

        config APP_VOICE_MODE_KWS
            bool "关键词识别：打开屏幕 / 关闭屏幕（模型还没接上）"
    endchoice

    config APP_SOUND_TRIGGER_ENABLE
        bool "启用音量触发开关屏"
        depends on APP_VOICE_MODE_LEVEL
        default n
        help
            不勾时麦克风照样采集、照样算音量，调试面板"声控"一行照常显示读数，
            只是响声不会去开关屏。可以先不勾，看着调试面板把阈值调好再打开。

    config APP_SOUND_THRESHOLD_DB
        int "触发音量 (dBFS)"
        depends on APP_VOICE_MODE_LEVEL
        range -60 0
        default -45
        help
            平滑后的音量（均方根，满幅为 0dB）升过这个值就切换一次屏幕。
            调试面板"声控"一行显示最近 1 秒平滑音量的最大值，拿它来调：
            想要触发的声音比这个值高、平时的动静（翻身、空调）比这个值低就对了。
            默认 -45 是实测值：增益 30dB 时，1 米左右正常说话或拍手能稳定触发。
            说话的均方根一般比峰值低 10dB 左右，所以比调试面板上的"峰值"要小。

    config APP_SOUND_SMOOTH_MS
        int "音量平滑时间常数 (ms)"
        depends on APP_VOICE_MODE_LEVEL
        range 20 1000
        default 100
        help
            越大越不容易被短促的响动（碰一下桌子、一声咔哒）触发，但拍手这种
            很短的声音也要更响才够得着阈值。

    config APP_SOUND_COOLDOWN_MS
        int "两次开关屏的最小间隔 (ms)"
        depends on APP_VOICE_MODE_LEVEL
        range 500 10000
        default 2000
        help
            从上一次开关屏（声控或者单击都算）完成起，这么久之内的声音不理会。

endmenu
